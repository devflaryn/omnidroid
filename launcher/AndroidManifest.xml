<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.omni.kiosk"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- See every installed package so we can find the game (Android 11+
         package-visibility rules would otherwise hide it). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Set a solid-black system wallpaper so no default Bliss wallpaper
         flashes between the boot animation and the game launching. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <application
        android:label="Omni Kiosk"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation|uiMode|screenLayout|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Device-admin receiver: lets the kiosk become device owner
             (dpm set-device-owner) to drive Lock Task Mode. -->
        <receiver
            android:name=".OmniDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
