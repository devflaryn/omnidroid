# Stray disk images are ignored, but the base images in images/ are
# tracked — the project needs them (note: >100MB files require git-lfs
# on GitHub; base_arm.qcow2 is ~2.1GB)
*.qcow2
*.img
*.iso
*.raw
!images/*

# Per-account runtime state (overlays, data disks, logs)
accounts/
work/

# Python
__pycache__/
*.pyc
.venv/

# Android build outputs (kiosk APK)
*.apk
launcher/build/
launcher/.gradle/
local.properties

# PyInstaller exe build artifacts
dist/
build/
*.exe
*.spec

# Auto-downloaded portable QEMU (fetched on first use, never committed)
qemu/

# OS noise
Thumbs.db
desktop.ini
