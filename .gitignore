# Disk images are NEVER committed — they live in the external data dir
# (images_dir in configs/paths.json; Windows C:/Users/berat/OmniImages,
# Linux ~/OmniImages) and are delivered/downloaded out of band.
*.qcow2
*.img
*.iso
*.raw
images/

# Per-account runtime state (overlays, data disks, logs). Also covers
# accounts/<name>/session.json, which holds a live .ROBLOSECURITY.
accounts/
work/

# Diskless per-instance throwaway state (per-boot efivars, run.json with
# ports, qemu.log, autocap frames). Never committed — regenerated every boot.
runtime/

# CREDENTIALS — a .ROBLOSECURITY cookie is full access to a Roblox account.
# Never commit one. `omnidroid login` writes cookies/<label>.json; `omnidroid play
# --token-file` reads a raw one.
cookies/
accounts.json
cookie.txt
cookies.txt
*.cookie
*cookie*.txt
tokens/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Android build outputs (kiosk APK)
*.apk
launcher/build/
launcher/.gradle/
local.properties

# PyInstaller exe build artifacts
dist/
build/
*.exe
*.spec

# Auto-downloaded portable QEMU (fetched on first use, never committed)
qemu/

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# Agent/tooling config + editors
.claude/
.opencode/
.codex/
.agents/
.vscode/
.idea/

# Python caches / stray run logs
.pytest_cache/
.mypy_cache/
*.log

# Generated knowledge-graph output (/graphify) and throwaway experiments.
# Both are regenerated on demand and neither is an input to anything.
graphify-out/
scratch/

# DEV MODE switch (configs/dev.json) — points this checkout's guests at a local
# omni-backend instead of 72.62.59.232. Machine-local by definition, and a
# committed one would silently redirect somebody else's VMs. See
# omnidroid/devserver.py.
configs/dev.json
bench-runs/
