#!/system/bin/sh
# omni-hide [package] — best-effort hiding of ROOT, MAGISK, and FRIDA from a
# target app's detection routines. Ships ONLY on the dev devkit disk.
#
# The dev base is rooted with MAGISK (a patched boot in the dev system overlay).
# Magisk's own hiding machinery is the tool here:
#   1. Add the target package to the Magisk DenyList so Magisk unmounts its
#      modifications and hides the su/daemon for that app (needs Zygisk +
#      Enforce DenyList — set once by omni-magisk-setup). Shamiko, if installed,
#      makes this a strong whitelist-style hide and conceals the Magisk app too.
#   2. Normalize the classic root/verified-boot prop "tells" with Magisk's
#      resetprop applet (build tags -> release-keys, verifiedbootstate -> green,
#      etc.). Idempotent: only changes props not already at the wanted value.
#   3. Confirm frida is NOT on the default 27042 port / "frida-server" name
#      (omni-fridad already binds a custom port + random process name).
#
# Root required (Magisk su). Prints what it applied vs. what was already clean.
if [ "$(id -u)" != 0 ]; then
    for SU in /debug_ramdisk/su /sbin/su su; do
        "$SU" 0 true 2>/dev/null && exec "$SU" 0 "$0" "$@"
    done
    echo "omni-hide: ERROR need Magisk root (su)" >&2; exit 1
fi

PKG="$1"
# Like su, the magisk applet lives in Magisk's own tmpfs, NOT on $PATH (a bare
# `command -v magisk` never finds it on this all-read-only base).
have_magisk=0
MAGISK_BIN=""
for M in /debug_ramdisk/magisk /sbin/magisk magisk; do
    "$M" -v >/dev/null 2>&1 && { MAGISK_BIN="$M"; have_magisk=1; break; }
done

# --- resetprop prop normalization (via the Magisk applet) ---
applied=""; already=""; skipped=""
want() {
    key="$1"; val="$2"
    if [ "$have_magisk" = 1 ]; then
        cur=$("$MAGISK_BIN" resetprop "$key" 2>/dev/null)
        if [ "$cur" = "$val" ]; then already="$already $key"; return; fi
        if "$MAGISK_BIN" resetprop -n "$key" "$val" >/dev/null 2>&1; then
            new=$("$MAGISK_BIN" resetprop "$key" 2>/dev/null)
            if [ "$new" = "$val" ]; then applied="$applied $key"; return; fi
        fi
    fi
    cur=$(getprop "$key" 2>/dev/null)
    if [ "$cur" = "$val" ]; then already="$already $key"; else skipped="$skipped $key"; fi
}

want ro.build.tags release-keys
want ro.build.type user
want ro.boot.verifiedbootstate green
want ro.boot.flash.locked 1
want ro.boot.veritymode enforcing
want ro.boot.vbmeta.device_state locked
want ro.boot.warranty_bit 0
want ro.warranty_bit 0
want ro.debuggable 0

# --- per-app Magisk DenyList (hide root + Magisk) ---
deny_note="(no package given)"
if [ -n "$PKG" ]; then
    if [ "$have_magisk" = 1 ]; then
        if "$MAGISK_BIN" --denylist add "$PKG" >/dev/null 2>&1; then
            deny_note="added $PKG to Magisk DenyList (root+Magisk hidden for it)"
        else
            deny_note="magisk present but denylist add not accepted for $PKG"
        fi
    else
        deny_note="magisk not found — dev boot not patched? ($PKG NOT hidden)"
    fi
fi

# --- frida sanity ---
frida_note="frida hidden-launch via omni-fridad (custom port, renamed process)"
if netstat -tln 2>/dev/null | grep -q "127.0.0.1:27042[^0-9]"; then
    frida_note="WARNING: something is listening on the DEFAULT frida port 27042"
fi

echo "omni-hide: props already clean:${already:- (none)}"
echo "omni-hide: props set now      :${applied:- (none)}"
[ -n "$skipped" ] && echo "omni-hide: props NOT set       :${skipped} (resetprop unavailable?)"
echo "omni-hide: Magisk   -> $deny_note"
echo "omni-hide: frida    -> $frida_note"
echo "omni-hide: root is Magisk; ensure Zygisk+DenyList are on (omni-magisk-setup)."
