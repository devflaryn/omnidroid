# omni-devkit.rc — init service for the dev/debug base (base-dev.qcow2 only).
#
# The frida-server service is DISABLED by default: a dev base should not have
# frida listening during every boot (a test that must NOT observe frida would
# be contaminated). Start it on demand instead:
#     adb root && adb shell omni-fridad
#   or, from init:
#     adb shell start omni_fridad
#
# It is defined here (rather than started ad-hoc) so `start omni_fridad`
# always works and the launch policy lives in one auditable place.
service omni_fridad /system/bin/omni-fridad
    class late_start
    user root
    group root inet
    oneshot
    disabled
    seclabel u:r:shell:s0
