-            /* omni: Windows has no madvise(), so every discard here used to
-             * return -ENOSYS -- the guest handed its pages back and the host
-             * kept paying for them. DiscardVirtualMemory() is MADV_DONTNEED
-             * in the ways that matter: the pages leave the working set, the
-             * frames are freed, the reservation and protection stay, and the
-             * next touch reads zeroes with no pagefile write.
+            /* omni: two discards, because there are two backings.
+             *
+             * A block from omni_win32_file_ram_alloc (patch 0007) has a real
+             * file behind it, and FSCTL_SET_ZERO_DATA is that file's
+             * fallocate(PUNCH_HOLE): the frames are freed, the file's
+             * AllocationSize drops, and the next touch reads zeroes. MEASURED
+             * (tools/probes/) to work on a range that is LIVE in a WHPX
+             * partition -- the hypervisor does not pin it.
+             *
+             * DiscardVirtualMemory is the private-commit equivalent and is
+             * kept for blocks with no file. It frees the frames but leaves
+             * the reservation, which is right for private memory and wrong
+             * for a mapping: DiscardVirtualMemory operates on privately
+             * committed pages, and against a mapped view it either fails or
+             * drops the pages without touching the file -- reclaiming the
+             * RAM and leaking the disk, which is the wall this patch exists
+             * to remove.
              * Resolved dynamically so the build does not depend on the SDK
              * declaring it. */
-            {
+            if (rb->omni_ram_file) {
+                HANDLE fh = (HANDLE)rb->omni_ram_file;
+                /* omni: round the punch INWARD to whole, aligned units
+                 * before ever calling DeviceIoControl.
+                 *
+                 * MEASURED (tools/probes/sparse_granularity.c) against a
+                 * live NTFS volume: FSCTL_SET_ZERO_DATA reclaims disk ONLY
+                 * for a range that is a whole granularity-aligned unit --
+                 *   4 KiB aligned    -> ok=1 reclaimed=0.000 MB
+                 *   32 KiB aligned   -> ok=1 reclaimed=0.000 MB
+                 *   64 KiB aligned   -> ok=1 reclaimed=0.062 MB  (whole unit)
+                 *   64 KiB UNaligned -> ok=1 reclaimed=0.000 MB
+                 * It reports success in every case -- it zero-FILLS what
+                 * it's given -- so a caller cannot tell "reclaimed" from
+                 * "zero-filled and still allocated" from the return value
+                 * alone. A per-4-KiB virtio-balloon page discard is exactly
+                 * the worst case: 2166 real calls against a live guest
+                 * (Task 4's own measurement) all returned success and
+                 * reclaimed nothing, because none of them were ever a whole
+                 * aligned unit. `omni_win32_alloc_granularity()` is the
+                 * same value Task 3 already computes for `mr->align` (64
+                 * KiB on the measured host, not hardcoded here either) --
+                 * the granularity a Windows allocation is guaranteed to
+                 * land on, and empirically the unit NTFS reclaims at.
+                 *
+                 * The bytes outside [punch_start, punch_end) are left
+                 * un-zeroed on purpose: this is guest RAM the balloon
+                 * driver has already given up, under virtio-balloon's own
+                 * contract that the guest will not read it again without a
+                 * fresh allocation, so a stale byte there costs nothing
+                 * real. Skipping the ioctl entirely when nothing whole
+                 * remains -- not attempting it and discarding the result --
+                 * is what turns "thousands of syscalls a minute under
+                 * free-page-reporting that free zero clusters" into "only
+                 * the calls that can work." See
+                 * tools/build_qemu.py:aligned_discard_interior() for the
+                 * tested reference this arithmetic must match.
+                 */
+                uint64_t granularity = omni_win32_alloc_granularity();
+                uint64_t abs_start = rb->fd_offset + offset;
+                uint64_t abs_end = abs_start + length;
+                uint64_t punch_start = QEMU_ALIGN_UP(abs_start, granularity);
+                uint64_t punch_end = QEMU_ALIGN_DOWN(abs_end, granularity);
+
+                if (punch_start < punch_end) {
+                    FILE_ZERO_DATA_INFORMATION zd;
+                    DWORD junk = 0;
+
+                    zd.FileOffset.QuadPart = (LONGLONG)punch_start;
+                    zd.BeyondFinalZero.QuadPart = (LONGLONG)punch_end;
+                    if (fh == INVALID_HANDLE_VALUE ||
+                        !DeviceIoControl(fh, FSCTL_SET_ZERO_DATA, &zd,
+                                         sizeof(zd), NULL, 0, &junk, NULL)) {
+                        ret = -EIO;
+                        error_report("%s: punch-hole failed %s:%" PRIx64
+                                     " +%zx", __func__, rb->idstr, offset,
+                                     length);
+                        goto err;
+                    }
+                }
+                ret = 0;
+            } else {
                 typedef DWORD (WINAPI *omni_discard_fn)(PVOID, SIZE_T);
                 static omni_discard_fn omni_discard;
                 static bool omni_discard_resolved;
