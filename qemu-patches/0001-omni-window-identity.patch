+    {
+        const char *omni_icon = g_getenv("QEMU_WINDOW_ICON");
+        GError *omni_icon_err = NULL;
+
+        if (!omni_icon || !*omni_icon ||
+            !gtk_window_set_icon_from_file(GTK_WINDOW(s->window), omni_icon,
+                                           &omni_icon_err)) {
+            if (omni_icon_err) {
+                g_error_free(omni_icon_err);
+            }
+            gtk_window_set_icon_name(GTK_WINDOW(s->window), "qemu");
+        }
+    }
 
     gd_create_menus(s, opts);
 
     s->console_notifier.notify = gd_console_notify;
     qemu_console_add_notifier(&s->console_notifier);
 
     gd_connect_signals(s);
 
     gtk_notebook_set_show_tabs(GTK_NOTEBOOK(s->notebook), FALSE);
     gtk_notebook_set_show_border(GTK_NOTEBOOK(s->notebook), FALSE);
 
     gd_update_caption(s);
 
     gtk_box_pack_start(GTK_BOX(s->vbox), s->menu_bar, FALSE, TRUE, 0);
     gtk_box_pack_start(GTK_BOX(s->vbox), s->notebook, TRUE, TRUE, 0);
 
     gtk_container_add(GTK_CONTAINER(s->window), s->vbox);
 
     gtk_widget_show_all(s->window);
 
