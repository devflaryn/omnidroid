@@ -1695,6 +1695,27 @@
   'data': 'DisplayUpdateOptions',
   'boxed' : true }
 
+##
+# @omni-host-cursor:
+#
+# Show or hide the host pointer over the gtk guest window.  Omni
+# addition: with `show-cursor=on` the host pointer is the only pointer
+# the user sees, until the guest application paints one of its own --
+# then the engine hides the host's with this.
+#
+# @visible: true to show the host pointer, false to blank it
+#
+# Since: 11.1 (omni)
+#
+# .. qmp-example::
+#
+#     -> { "execute": "omni-host-cursor", "arguments": { "visible": false } }
+#     <- { "return": {} }
+##
+{ 'command': 'omni-host-cursor',
+  'data': { 'visible': 'bool' },
+  'if': 'CONFIG_GTK' }
+
 ##
