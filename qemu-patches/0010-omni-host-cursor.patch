@@ -3299,3 +3311,31 @@ type_init(register_gtk);
 #ifdef CONFIG_OPENGL
 module_dep("ui-opengl");
 #endif
+
+/*
+ * omni: show or hide the host pointer over the guest window at run time.
+ *
+ * With `-display gtk,show-cursor=on` the host's own pointer is what the user
+ * sees over the guest -- zero latency, and the guest's software-drawn Android
+ * pointer is blanked by a resource overlay in the image. The one time that is
+ * wrong is when the guest application paints a pointer of its own (Roblox
+ * inside a place): two arrows on screen. The engine watches for that state
+ * and flips this, so exactly one pointer is ever visible.
+ *
+ * QMP runs on the main loop thread, which is also GTK's thread here, so
+ * touching the GdkWindow directly is safe.
+ */
+void qmp_omni_host_cursor(bool visible, Error **errp)
+{
+    GtkDisplayState *s = gtk_display_state;
+    int i;
+
+    if (!s) {
+        error_setg(errp, "no gtk display is up");
+        return;
+    }
+    s->omni_cursor_hidden = !visible;
+    for (i = 0; i < s->vcs->len; i++) {
+        gd_update_cursor(g_ptr_array_index(s->vcs, i));
+    }
+}
diff --git a/qapi/ui.json b/qapi/ui.json
index b2c42a7..d3535ee 100644
--- a/qapi/ui.json
