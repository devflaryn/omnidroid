+#ifdef G_OS_WIN32
+/* omni: the guest's current scanout size.
+ *
+ * On a GL boot the picture never goes through the 2D surface -- it arrives
+ * as a texture via dpy_gl_scanout_texture, which stores the real size in
+ * vc->gfx.w/h. vc->gfx.ds keeps whatever the last 2D surface was, which on
+ * this stack is QEMU's own 640x480 startup mode, FOREVER. Reading ds here
+ * is why the window stayed 4:3 while the guest ran 1280x800, and why
+ * screendump reports "no surface" on these boots.
+ */
+static bool omni_guest_size(VirtualConsole *vc, int *w, int *h)
+{
+    if (vc->gfx.w > 0 && vc->gfx.h > 0) {
+        *w = vc->gfx.w;
+        *h = vc->gfx.h;
+        return true;
+    }
+    if (vc->gfx.ds) {
+        *w = surface_width(vc->gfx.ds);
+        *h = surface_height(vc->gfx.ds);
+        return *w > 0 && *h > 0;
+    }
+    return false;
+}
+
+/* omni: keep the CLIENT area at the guest's aspect ratio while resizing.
+ *
+ * Windows sends WM_SIZING with the proposed OUTER rect while the user drags
+ * an edge, and lets the handler rewrite it. We subtract the chrome, correct
+ * the side that is not leading the drag, and add the chrome back -- so the
+ * picture fills the window edge to edge at every size, with no letterboxing.
+ */
+static GdkFilterReturn omni_aspect_filter(GdkXEvent *xevent, GdkEvent *event,
+                                          gpointer opaque)
+{
+    VirtualConsole *vc = opaque;
+    MSG *msg = (MSG *)xevent;
+    RECT *want, wr, cr;
+    int chrome_w, chrome_h, gw, gh, cw, ch, want_w, want_h;
+
+    if (msg->message != WM_SIZING || !omni_guest_size(vc, &gw, &gh)) {
+        return GDK_FILTER_CONTINUE;
+    }
+    if (!GetWindowRect(msg->hwnd, &wr) || !GetClientRect(msg->hwnd, &cr)) {
+        return GDK_FILTER_CONTINUE;
+    }
+    chrome_w = (wr.right - wr.left) - (cr.right - cr.left);
+    chrome_h = (wr.bottom - wr.top) - (cr.bottom - cr.top);
+
+    want = (RECT *)msg->lParam;
+    cw = (want->right - want->left) - chrome_w;
+    ch = (want->bottom - want->top) - chrome_h;
+    if (cw <= 0 || ch <= 0) {
+        return GDK_FILTER_CONTINUE;
+    }
+
+    switch (msg->wParam) {
+    case WMSZ_LEFT:
+    case WMSZ_RIGHT:
+        ch = cw * gh / gw;              /* width leads, height follows */
+        break;
+    case WMSZ_TOP:
+    case WMSZ_BOTTOM:
+        cw = ch * gw / gh;              /* height leads, width follows */
+        break;
+    default:                            /* a corner: follow the bigger move */
+        if ((int64_t)cw * gh > (int64_t)ch * gw) {
+            ch = cw * gh / gw;
+        } else {
+            cw = ch * gw / gh;
+        }
+        break;
+    }
+
+    want_w = cw + chrome_w;
+    want_h = ch + chrome_h;
+    /* Move the edge the user is actually dragging, so the opposite edge
+     * stays put and the window does not walk across the screen. */
+    switch (msg->wParam) {
+    case WMSZ_LEFT:
+    case WMSZ_TOPLEFT:
+    case WMSZ_BOTTOMLEFT:
+        want->left = want->right - want_w;
+        break;
+    default:
+        want->right = want->left + want_w;
+        break;
+    }
+    switch (msg->wParam) {
+    case WMSZ_TOP:
+    case WMSZ_TOPLEFT:
+    case WMSZ_TOPRIGHT:
+        want->top = want->bottom - want_h;
+        break;
+    default:
+        want->bottom = want->top + want_h;
+        break;
+    }
+    return GDK_FILTER_CONTINUE;
+}
+
+/* omni: make the window's CLIENT area match the guest's aspect ratio.
+ *
+ * Called whenever the surface changes, so the ratio tracks the guest LIVE
+ * rather than being frozen at whatever the display was when the window
+ * opened -- the guest's panel is not up yet at that point, so freezing it
+ * locks in the wrong shape. Keeps the user's current width and moves only
+ * the height, so re-fitting never fights a resize the user just made.
+ */
+void omni_fit_window_to_aspect(VirtualConsole *vc)
+{
+    GtkWidget *win = vc->window ? vc->window : vc->s->window;
+    GdkWindow *gdkwin;
+    HWND hwnd;
+    RECT wr, cr;
+    int chrome_w, chrome_h, gw, gh, cw, want_h;
+
+    if (!win) {
+        return;
+    }
+    gdkwin = gtk_widget_get_window(win);
+    if (!gdkwin) {
+        return;
+    }
+    hwnd = (HWND)gdk_win32_window_get_handle(gdkwin);
+    if (!hwnd || !GetWindowRect(hwnd, &wr) || !GetClientRect(hwnd, &cr)) {
+        return;
+    }
+    cw = cr.right - cr.left;
+    if (!omni_guest_size(vc, &gw, &gh) || cw <= 0) {
+        return;
+    }
+    chrome_w = (wr.right - wr.left) - cw;
+    chrome_h = (wr.bottom - wr.top) - (cr.bottom - cr.top);
+    want_h = cw * gh / gw;
+    if (want_h == cr.bottom - cr.top) {
+        return;                     /* already the right shape */
+    }
+    SetWindowPos(hwnd, NULL, 0, 0, cw + chrome_w, want_h + chrome_h,
+                 SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);
+}
+
+static void omni_install_aspect_filter(VirtualConsole *vc)
+{
+    GtkWidget *win = vc->window ? vc->window : vc->s->window;
+    GdkWindow *gdkwin;
+
+    if (!win || g_object_get_data(G_OBJECT(win), "omni-aspect-filter")) {
+        return;
+    }
+    gtk_widget_realize(win);
+    gdkwin = gtk_widget_get_window(win);
+    if (!gdkwin) {
+        return;
+    }
+    gdk_window_add_filter(gdkwin, omni_aspect_filter, vc);
+    g_object_set_data(G_OBJECT(win), "omni-aspect-filter", GINT_TO_POINTER(1));
+}
+#endif /* G_OS_WIN32 */
+
 static void gd_update_geometry_hints(VirtualConsole *vc)
 {
     GtkDisplayState *s = vc->s;
     GdkWindowHints mask = 0;
     GdkGeometry geo = {};
     GtkWidget *geo_widget = NULL;
     GtkWindow *geo_window;
 
     if (vc->type == GD_VC_GFX) {
         if (!vc->gfx.ds) {
             return;
         }
         double scale_x = s->free_scale ? VC_SCALE_MIN : vc->gfx.scale_x;
         double scale_y = s->free_scale ? VC_SCALE_MIN : vc->gfx.scale_y;
         geo.min_width  = surface_width(vc->gfx.ds) * scale_x;
         geo.min_height = surface_height(vc->gfx.ds) * scale_y;
         mask |= GDK_HINT_MIN_SIZE;
+
+        /* omni: lock the window to the guest's aspect ratio, so dragging a
+         * corner cannot letterbox or stretch the picture. Opt-in, so the
+         * stock behaviour is unchanged when the variable is unset. */
+        if (g_getenv("QEMU_WINDOW_LOCK_ASPECT")) {
+#ifdef G_OS_WIN32
+            /* GDK_HINT_ASPECT constrains the WHOLE window, decorations
+             * included -- GTK >= 3.20 ignores the geometry_widget argument
+             * below. MEASURED: a 1280x800 guest ended up with a 1711x1028
+             * client (ratio 1.664 against the guest's 1.600), i.e. 4% too
+             * wide, which QEMU letterboxes into ~33px black bars down each
+             * side. No fixed outer ratio can fix it either: the chrome is a
+             * constant (+16 x +39 here), so the correct outer ratio changes
+             * with the window size. Windows therefore gets a WM_SIZING
+             * filter that constrains the CLIENT area directly. */
+            omni_install_aspect_filter(vc);
+#else
+            int omni_w = surface_width(vc->gfx.ds);
+            int omni_h = surface_height(vc->gfx.ds);
+
+            if (omni_w > 0 && omni_h > 0) {
+                geo.min_aspect = geo.max_aspect = (double)omni_w / omni_h;
+                mask |= GDK_HINT_ASPECT;
+            }
+#endif
+        }
         geo_widget = vc->gfx.drawing_area;
         gtk_widget_set_size_request(geo_widget, geo.min_width, geo.min_height);
 
 #if defined(CONFIG_VTE)
     } else if (vc->type == GD_VC_VTE) {
         VteTerminal *term = VTE_TERMINAL(vc->vte.terminal);
         GtkBorder padding = { 0 };
 
 #if VTE_CHECK_VERSION(0, 37, 0)
         gtk_style_context_get_padding(
                 gtk_widget_get_style_context(vc->vte.terminal),
                 gtk_widget_get_state_flags(vc->vte.terminal),
                 &padding);
 #else
         {
             GtkBorder *ib = NULL;
             gtk_widget_style_get(vc->vte.terminal, "inner-border", &ib, NULL);
             if (ib) {
                 padding = *ib;
                 gtk_border_free(ib);
@@ -329,40 +515,49 @@ static void gd_update_geometry_hints(VirtualConsole *vc)
         mask |= GDK_HINT_MIN_SIZE;
 
         geo.base_width  += padding.left + padding.right;
         geo.base_height += padding.top + padding.bottom;
         geo.min_width   += padding.left + padding.right;
         geo.min_height  += padding.top + padding.bottom;
         geo_widget = vc->vte.terminal;
 #endif
     }
 
     geo_window = GTK_WINDOW(vc->window ? vc->window : s->window);
     gtk_window_set_geometry_hints(geo_window, geo_widget, &geo, mask);
 }
 
 void gd_update_windowsize(VirtualConsole *vc)
 {
     GtkDisplayState *s = vc->s;
 
     gd_update_geometry_hints(vc);
 
+#ifdef G_OS_WIN32
+    /* zoom-to-fit leaves the window at whatever size it already had, so a
+     * guest that changes mode leaves the window at the OLD ratio and QEMU
+     * letterboxes into it. Re-fit instead. */
+    if (vc->type == GD_VC_GFX && g_getenv("QEMU_WINDOW_LOCK_ASPECT")) {
+        omni_fit_window_to_aspect(vc);
+    }
+#endif
+
     if (vc->type == GD_VC_GFX && !s->full_screen && !s->free_scale) {
         gtk_window_resize(GTK_WINDOW(vc->window ? vc->window : s->window),
                           VC_WINDOW_X_MIN, VC_WINDOW_Y_MIN);
     }
 }
 
 static void gd_update_full_redraw(VirtualConsole *vc)
 {
     GtkWidget *area = vc->gfx.drawing_area;
     int ww, wh;
     ww = gdk_window_get_width(gtk_widget_get_window(area));
     wh = gdk_window_get_height(gtk_widget_get_window(area));
 #if defined(CONFIG_OPENGL)
     if (vc->gfx.gls && gtk_use_gl_area) {
         gtk_gl_area_queue_render(GTK_GL_AREA(vc->gfx.drawing_area));
         return;
     }
 #endif
     gtk_widget_queue_draw_area(area, 0, 0, ww, wh);
 }
