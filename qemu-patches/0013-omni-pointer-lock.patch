+/*
+ * omni: widget-relative (wx, wy) of the drawing area -> coordinates in the
+ * toplevel GtkWindow. Needed because a GtkGLArea has no GdkWindow of its own:
+ * gtk_widget_get_window() hands back the TOPLEVEL's window, so feeding it
+ * drawing-area coordinates is only right while the area sits at (0, 0).
+ */
+static GtkWidget *omni_ptr_to_toplevel(VirtualConsole *vc, int wx, int wy,
+                                       int *tx, int *ty)
+{
+    GtkWidget *top = gtk_widget_get_toplevel(vc->gfx.drawing_area);
+
+    if (!top || !gtk_widget_translate_coordinates(vc->gfx.drawing_area, top,
+                                                  wx, wy, tx, ty)) {
+        *tx = wx;
+        *ty = wy;
+        top = vc->gfx.drawing_area;
+    }
+    return top;
+}
+
+/* omni: put the host pointer on drawing-area pixel (wx, wy) */
+static void omni_ptr_warp_widget(VirtualConsole *vc, int wx, int wy)
+{
+    GtkWidget *top;
+    GdkDisplay *dpy;
+    gint tx, ty, x_root, y_root;
+
+    if (!gtk_widget_get_realized(vc->gfx.drawing_area)) {
+        return;
+    }
+    top = omni_ptr_to_toplevel(vc, wx, wy, &tx, &ty);
+    dpy = gtk_widget_get_display(vc->gfx.drawing_area);
+    gdk_window_get_root_coords(gtk_widget_get_window(top), tx, ty,
+                               &x_root, &y_root);
+    gdk_device_warp(gd_get_pointer(dpy),
+                    gtk_widget_get_screen(vc->gfx.drawing_area),
+                    x_root, y_root);
+}
+
+#ifdef G_OS_WIN32
+/*
+ * omni: ClipCursor to the drawing area's screen rectangle, in device pixels
+ * (the HWND's client origin plus the widget's allocation times the GDK
+ * scale). Windows clears the clip on its own whenever focus changes or the
+ * window moves, so callers re-arm it rather than assume it holds.
+ */
+static void omni_ptr_clip(VirtualConsole *vc, bool clip)
+{
+    GtkWidget *top;
+    GdkWindow *gdkwin;
+    HWND hwnd;
+    POINT p0, p1;
+    RECT r;
+    int tx, ty, scale;
+
+    if (!clip) {
+        ClipCursor(NULL);
+        return;
+    }
+    if (!gtk_widget_get_realized(vc->gfx.drawing_area)) {
+        return;
+    }
+    top = omni_ptr_to_toplevel(vc, 0, 0, &tx, &ty);
+    gdkwin = gtk_widget_get_window(top);
+    hwnd = gdkwin ? (HWND)gdk_win32_window_get_handle(gdkwin) : NULL;
+    if (!hwnd) {
+        return;
+    }
+    scale = gtk_widget_get_scale_factor(vc->gfx.drawing_area);
+    p0.x = tx * scale;
+    p0.y = ty * scale;
+    p1.x = (tx + gtk_widget_get_allocated_width(vc->gfx.drawing_area)) * scale;
+    p1.y = (ty + gtk_widget_get_allocated_height(vc->gfx.drawing_area)) * scale;
+    if (!ClientToScreen(hwnd, &p0) || !ClientToScreen(hwnd, &p1)) {
+        return;
+    }
+    r.left = p0.x;
+    r.top = p0.y;
+    r.right = p1.x;
+    r.bottom = p1.y;
+    ClipCursor(&r);
+}
+#endif /* G_OS_WIN32 */
