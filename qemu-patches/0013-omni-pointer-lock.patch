+/*
+ * omni: lock the host pointer to the guest window and feed the guest
+ * relative motion.
+ *
+ * The guest's pointing device is an absolute tablet (virtio-tablet-pci), so
+ * the host pointer maps 1:1 onto the guest screen with zero latency -- right
+ * for everything except mouse-look, where the game wants unbounded deltas
+ * and the host pointer instead walks to the window edge and stops. While
+ * locked the GTK display takes the relative branch of gd_motion_event()
+ * whatever qemu_input_is_absolute() says (the deltas land on a
+ * virtio-mouse-pci if one is attached, see qemu_input_queue_rel), hides the
+ * host pointer, grabs it, keeps re-centring it inside the drawing area and,
+ * on Windows, clips it there too. The engine flips this on when the guest
+ * enters mouse-look and off when it leaves, handing back the guest pixel the
+ * host pointer should reappear on so the two never visibly diverge.
+ *
+ * QMP runs on the main loop thread, which is also GTK's thread here.
+ */
+void qmp_omni_pointer_lock(bool enabled,
+                           bool has_warp_x, int64_t warp_x,
+                           bool has_warp_y, int64_t warp_y,
+                           Error **errp)
+{
+    GtkDisplayState *s = gtk_display_state;
+    VirtualConsole *vc;
+    int ww_widget, wh_widget;
+
+    if (!s) {
+        error_setg(errp, "no gtk display is up");
+        return;
+    }
+    vc = gd_vc_find_current(s);
+    if (!vc || vc->type != GD_VC_GFX ||
+        !qemu_console_is_graphic(vc->gfx.dcl.con) ||
+        !gtk_widget_get_realized(vc->gfx.drawing_area)) {
+        error_setg(errp, "current console is not a realized graphic console");
+        return;
+    }
+    ww_widget = gtk_widget_get_allocated_width(vc->gfx.drawing_area);
+    wh_widget = gtk_widget_get_allocated_height(vc->gfx.drawing_area);
+
+    if (enabled) {
+        s->omni_ptr_lock = TRUE;
+#ifdef G_OS_WIN32
+        /*
+         * No GDK seat grab on Windows. Measured: a gdk_seat_grab() taken
+         * from QMP (outside any input event) leaves the window receiving
+         * NO motion at all -- the warp's own event arrives and then
+         * nothing, while the pointer visibly moves. ClipCursor already does
+         * the confining here, so the lock just takes ownership the way the
+         * grab would have (ptr_owner + the origin to warp back to).
+         */
+        if (s->ptr_owner && s->ptr_owner != vc) {
+            gd_ungrab_pointer(s);
+        }
+        gdk_device_get_position(gd_get_pointer(gtk_widget_get_display(
+                                    vc->gfx.drawing_area)),
+                                NULL, &s->grab_x_root, &s->grab_y_root);
+        s->ptr_owner = vc;
+#else
+        gd_grab_pointer(vc, "omni-pointer-lock");
+#endif
+        omni_ptr_warp_widget(vc, ww_widget / 2, wh_widget / 2);
+        /* the warp's own motion event must not become a delta */
+        s->last_set = FALSE;
+#ifdef G_OS_WIN32
+        omni_ptr_clip(vc, true);
+#endif
+        gd_update_cursor(vc);
+        if (getenv("QEMU_UI_LOCK_DEBUG")) {
+            fprintf(stderr, "omni-lock: ON owner=%d origin=%d,%d\n",
+                    (int)(s->ptr_owner == vc), s->grab_x_root,
+                    s->grab_y_root);
+        }
+        return;
+    }
+
+    s->omni_ptr_lock = FALSE;
+#ifdef G_OS_WIN32
+    omni_ptr_clip(vc, false);
+    /* the mirror of the ownership taken above: no GDK grab to release,
+     * just the pointer back where the lock found it */
+    if (s->ptr_owner == vc) {
+        s->ptr_owner = NULL;
+        gdk_device_warp(gd_get_pointer(gtk_widget_get_display(
+                            vc->gfx.drawing_area)),
+                        gtk_widget_get_screen(vc->gfx.drawing_area),
+                        s->grab_x_root, s->grab_y_root);
+    }
+#else
+    /* puts the pointer back where the grab found it; overridden below */
+    gd_ungrab_pointer(s);
+#endif
+    if (getenv("QEMU_UI_LOCK_DEBUG")) {
+        fprintf(stderr, "omni-lock: OFF\n");
+    }
+    if (has_warp_x && has_warp_y && vc->gfx.ds) {
+        /*
+         * Guest framebuffer pixel -> drawing-area pixel: the inverse of
+         * what gd_motion_event() does, letterbox offsets included.
+         */
+        int ww_surface = surface_width(vc->gfx.ds) * vc->gfx.scale_x;
+        int wh_surface = surface_height(vc->gfx.ds) * vc->gfx.scale_y;
+        int wx_offset = 0, wy_offset = 0;
+        int wx, wy;
+
+        if (ww_widget > ww_surface) {
+            wx_offset = (ww_widget - ww_surface) / 2;
+        }
+        if (wh_widget > wh_surface) {
+            wy_offset = (wh_widget - wh_surface) / 2;
+        }
+        wx = warp_x * vc->gfx.scale_x + wx_offset;
+        wy = warp_y * vc->gfx.scale_y + wy_offset;
+        omni_ptr_warp_widget(vc, wx, wy);
+    }
+    s->last_set = FALSE;
+    gd_update_cursor(vc);
+}
