+##
+# @omni-pointer-lock:
+#
+# Lock the host pointer to the gtk guest window.  Omni addition: a
+# guest game in mouse-look (Roblox with the right button held, or a
+# first-person camera) needs unbounded relative motion, but the
+# guest's input device is an absolute tablet, so the host pointer
+# walks to the window edge and stops.  While locked the display
+# feeds the guest RELATIVE deltas whatever the input device reports
+# itself as, hides the host pointer, grabs it, and keeps re-centring
+# it inside the drawing area (on Windows it is also clipped to the
+# drawing area).
+#
+# @enabled: true to lock, false to release
+#
+# @warp-x: on release, x of the guest framebuffer pixel to put the
+#     host pointer on, so it reappears where the guest's own pointer
+#     is
+#
+# @warp-y: on release, y of that guest pixel
+#
+# Since: 11.1 (omni)
+#
+# .. qmp-example::
+#
+#     -> { "execute": "omni-pointer-lock",
+#          "arguments": { "enabled": true } }
+#     <- { "return": {} }
+#     -> { "execute": "omni-pointer-lock",
+#          "arguments": { "enabled": false,
+#                         "warp-x": 960, "warp-y": 540 } }
+#     <- { "return": {} }
+##
+{ 'command': 'omni-pointer-lock',
+  'data': { 'enabled': 'bool', '*warp-x': 'int', '*warp-y': 'int' },
+  'if': 'CONFIG_GTK' }
+
 ##
 # @client_migrate_info:
 #
