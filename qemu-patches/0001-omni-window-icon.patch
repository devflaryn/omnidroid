diff --git a/ui/gtk.c b/ui/gtk.c
index 7078d89d67..37650292b9 100644
--- a/ui/gtk.c
+++ b/ui/gtk.c
@@ -229,7 +229,8 @@ static void gd_update_caption(GtkDisplayState *s)
     int i;
 
     if (qemu_name) {
-        prefix = g_strdup_printf("QEMU (%s)", qemu_name);
+        /* omni: the embedder owns the caption; -name is the title. */
+        prefix = g_strdup_printf("%s", qemu_name);
     } else {
         prefix = g_strdup_printf("QEMU");
     }
@@ -2759,7 +2760,21 @@ static void gtk_display_init(DisplayState *ds, DisplayOptions *opts)
     qemu_add_mouse_mode_change_notifier(&s->mouse_mode_notifier);
     s->vmse = qemu_add_vm_change_state_handler(gd_change_runstate, s);
 
-    gtk_window_set_icon_name(GTK_WINDOW(s->window), "qemu");
+    /* omni: use the embedder's own logo when it points at one. Falls
+     * back to the stock icon so this build stays a drop-in replacement. */
+    {
+        const char *omni_icon = g_getenv("QEMU_WINDOW_ICON");
+        GError *omni_icon_err = NULL;
+
+        if (!omni_icon || !*omni_icon ||
+            !gtk_window_set_icon_from_file(GTK_WINDOW(s->window), omni_icon,
+                                           &omni_icon_err)) {
+            if (omni_icon_err) {
+                g_error_free(omni_icon_err);
+            }
+            gtk_window_set_icon_name(GTK_WINDOW(s->window), "qemu");
+        }
+    }
 
     gd_create_menus(s, opts);
 
