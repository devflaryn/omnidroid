+        if (it == unverified.end()) {
+            return std::nullopt;
+        }
+        pending = it->second;
+    }
+    // Read back outside the lock, as the frontend reads.
+    const auto hash = GuestCodeHash(translator_conf, pending.first, pending.first + pending.span);
