+/// The jumps waiting for a label, unordered: `find` the first for an id, `erase` one (the last moves
+/// into its place), `insert` one. Only what `LabelManager` uses of a multimap.
+class UndefList {
+public:
+	typedef std::pair<int, JmpLabel> value_type;
+	typedef std::vector<value_type>::iterator iterator;
+	typedef std::vector<value_type>::const_iterator const_iterator;
+	void insert(const value_type& v) { list_.push_back(v); }
+	iterator find(int id)
+	{
+		for (iterator i = list_.begin(), e = list_.end(); i != e; ++i) {
+			if (i->first == id) return i;
+		}
+		return list_.end();
+	}
+	void erase(iterator i)
+	{
+		if (i + 1 != list_.end()) *i = list_.back();
+		list_.pop_back();
+	}
+	iterator begin() { return list_.begin(); }
+	iterator end() { return list_.end(); }
+	const_iterator begin() const { return list_.begin(); }
+	const_iterator end() const { return list_.end(); }
+	bool empty() const { return list_.empty(); }
+	void clear() { list_.clear(); }
+private:
+	std::vector<value_type> list_;
+};
+} // namespace od
