+        code.STR(Qarg, oaknut::XReg{i});
+        i++;
+    }
+    code.MOV(oaknut::WReg{i}, fpcr);
+    code.ADD(oaknut::XReg{i + 1}, Xstate, ctx.conf.state_fpsr_offset);
+    code.BLR(Xscratch0);
+    code.LDR(Qresult, SP);
+
+    ABI_PopRegisters(code, ABI_CALLER_SAVE & ~ToRegList(Qresult), stack_size);
