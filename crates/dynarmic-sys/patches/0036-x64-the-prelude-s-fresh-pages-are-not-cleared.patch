     void* ret = getCurr<void*>();
     size_ += alloc_size;
-    memset(ret, 0, alloc_size);
+    // Omnidroid patch 0036: before the prelude is complete the insertion point has only ever moved
+    // forward through a reservation nothing has written yet -- freshly committed (Windows) or
+    // freshly mapped (elsewhere) pages, which read zero already. Writing zeros over them made
+    // every page resident: the 2 MiB constant pool of every code cache, of which a few KiB hold
+    // constants. MEASURED (PS99 in-world, the system's host process, ~65 caches): 84 MiB of the
+    // executable regions were resident pages of zeros. Later allocations (none today) are cleared
+    // as before, and `OMNI_JIT_POOL_MEMSET=1` clears these too (the old behaviour, for an A/B).
+    if (prelude_complete || PoolMemsetForced()) {
+        memset(ret, 0, alloc_size);
+    }
     return ret;
 }
 
+bool BlockOfCode::PoolMemsetForced() {
+    static const bool forced = [] {
+        const char* v = std::getenv("OMNI_JIT_POOL_MEMSET");
+        return v != nullptr && v[0] == '1';
+    }();
+    return forced;
+}
