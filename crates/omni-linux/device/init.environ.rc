# set up the global environment
# (AOSP system/core/rootdir/init.environ.rc.in, android15-release, with its build-time
# placeholders -- sanitizer and coverage options -- empty, as a user build leaves them. It is the
# boot ramdisk's, which omnidroid provides: the system image does not carry it.)
on early-init
    export ANDROID_BOOTLOGO 1
    export ANDROID_ROOT /system
    export ANDROID_ASSETS /system/app
    export ANDROID_DATA /data
    export ANDROID_STORAGE /storage
    export ANDROID_ART_ROOT /apex/com.android.art
    export ANDROID_I18N_ROOT /apex/com.android.i18n
    export ANDROID_TZDATA_ROOT /apex/com.android.tzdata
    export EXTERNAL_STORAGE /sdcard
    export ASEC_MOUNTPOINT /mnt/asec
