@@ -240,6 +244,30 @@ vkr_ring_submit_cmd(struct vkr_ring *ring,
    return true;
 }
 
+#ifdef _WIN32
+/* Windows has no setpriority(PRIO_PROCESS, ...) per-thread nice value.  Map the
+ * POSIX nice range (-20 highest .. 19 lowest) onto Windows thread priorities.
+ * Returns 0 on success like setpriority().
+ */
+static int
+vkr_ring_set_thread_priority(int prio)
+{
+   int win_prio;
+   if (prio <= -10)
+      win_prio = THREAD_PRIORITY_HIGHEST;
+   else if (prio < 0)
+      win_prio = THREAD_PRIORITY_ABOVE_NORMAL;
+   else if (prio == 0)
+      win_prio = THREAD_PRIORITY_NORMAL;
+   else if (prio < 10)
+      win_prio = THREAD_PRIORITY_BELOW_NORMAL;
+   else
+      win_prio = THREAD_PRIORITY_LOWEST;
+
+   return SetThreadPriority(GetCurrentThread(), win_prio) ? 0 : -1;
+}
+#endif
