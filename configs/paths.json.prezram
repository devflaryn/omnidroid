      "src": "/android-2024-10-11",
      "notes": "canonical x86_64 base (Bliss 16.9.7). Versionless filename mirrors base_arm; lineage tracked in 'version' + 'changelog' (files were base-v5.* until 2026-07-09).",
      "changelog": {
        "1": "pristine Bliss OS 16.9.7 x86_64 (2026-07-05)",
        "2": "v1 + custom loading screen + kiosk system app (2026-07-05)",
        "3": "v2 + kiosk with black wallpaper; silent boot moved host-side (2026-07-06)",
        "4": "v3 + pre-installed game com.roblox.client as system app - PRODUCTION (2026-07-06)",
        "5": "updated kiosk (Lock Task lockdown + boot/RAM trims) (2026-07-06)"
      }
    },
    "arm": {
      "type": "arm-uefi",
      "base_disk": "base_arm_v2.qcow2",
      "system": "base_arm_system.qcow2",
      "data": "base_arm_data.qcow2",
      "efivars": "base_arm_efivars.fd",
      "src": "https://github.com/jqssun/android-lineage-qemu (LineageOS 23.2 arm64, virtio_arm64only)",
      "notes": "arm64/UEFI base (LineageOS 23.2). v2 = branded + silent + insecure_adb + Roblox baked in. base_arm.qcow2 (v1) is kept because existing account overlays are still COW-backed by it.",
      "version": 2,
      "changelog": {
        "1": "pristine LineageOS 23.2 arm64 (jqssun virtio) + kiosk/device-owner provisioned pair",
        "2": "v1 + Omni loading screen (product/media), silent boot (quiet/loglevel=0), GRUB menu hidden (no LineageOS logo/countdown), androidboot.insecure_adb=1 (adb reachable on a fresh boot - without it every new account stalls on 'Allow USB debugging?'), and Roblox pre-installed as a system app in /product/app/Roblox with its arm64 native libs (2026-07-17)"
      }
    },
    "dev": {
      "type": "arm-uefi",
      "base_disk": "base_arm.qcow2",
      "system": "base_arm_devsystem.qcow2",
      "data": "base_arm_devdata.qcow2",
      "efivars": "base_arm_efivars.fd",
      "devkit": "base_arm_devkit.qcow2",
      "src": "base_arm + devkit disk (frida + Magisk + omni tools)",
      "notes": "arm dev base: base_arm + base_arm_devkit.qcow2 (vdc) with frida 17.15.4 (arm64) + Magisk [rooted]. omni-agent only; NOT shipped. hidden frida port 27142. devsystem v2: same branding/silent/insecure_adb as base_arm v2 (the dev system image is STANDALONE, so it does not inherit the shared base's branding and must be branded separately).",
      "devkit_manifest": {
        "frida_version": "17.15.4",
        "frida_port": 27142,
        "magisk": true,
        "magisk_version": "v30.7",
        "rooted": true,
        "tools": [
          "frida-server",
          "omni-fridad",
          "omni-frida-stop",
          "omni-hide",
          "omni-magisk-setup"
        ]
      }
    }
  },
  "qemu": {
    "mem_mb": 4096,
    "smp": 4,
    "data_disk_size": "8G",
    "adb_port_start": 16001,
    "qmp_port_start": 17001,
